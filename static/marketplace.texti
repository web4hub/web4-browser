                        </div>
                        <div class="row g-3" id="marketIndices">
                            <!-- Token assets metrics populate here dynamically -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Open Verifiable Distributed P2P Orders Registry -->
            <div class="card bg-dark bg-opacity-50 border-secondary p-3 shadow-sm">
                <h6 class="text-white mb-3"><i class="bi bi-list-stars text-info me-2"></i>P2P Intent Mesh (Order Pipeline)</h6>
                <div class="table-responsive">
                    <table class="table table-dark table-hover border-secondary align-middle mb-0" style="font-size: 0.85rem;">
                        <thead>
                            <tr class="text-secondary font-mono border-secondary">
                                <th>INTENT SPECIFIER ID</th>
                                <th>ASSET PATH</th>

// Token State Ledger Datastores
let localVault = {
'W4': { balance: 2500.00, price: 1.24, prefix: '⎔' },
'WETH': { balance: 4.12, price: 2840.50, prefix: 'Ξ' },
'ZKP': { balance: 140.00, price: 8.75, prefix: '🛡' }
};
let activeIntents = [
{ id: 'w4-intent-77a', asset: 'W4', dir: 'BUY', qty: 500, state: 'Matching' },
{ id: 'w4-intent-12f', asset: 'ZKP', dir: 'SELL', qty: 25, state: 'Settle_Pending' },
{ id: 'w4-intent-90c', asset: 'WETH', dir: 'BUY', qty: 1.5, state: 'Settled_Verified' }
];
window.onload = () => {
refreshMarketUiAll();
};
function refreshMarketUiAll() {
// Render Wallet Portfolio Balances
const vaultList = document.getElementById('vaultBalances');
vaultList.innerHTML = '';
for (let key in localVault) {
const token = localVault[key];
const div = document.createElement('div');
div.className = 'asset-card p-2 rounded d-flex justify-content-between align-items-center text-light';
div.innerHTML = <div> <span class="small fw-bold font-mono">${token.prefix} ${key}</span> <div class="text-secondary font-mono" style="font-size:10px;">Value: $${(token.balance * token.price).toFixed(2)}</div> </div> <span class="badge bg-dark border border-secondary font-mono text-info">${token.balance.toFixed(2)}</span>;
vaultList.appendChild(div);
}
// Render Active Token Metrics Cards
const indexRow = document.getElementById('marketIndices');
indexRow.innerHTML = '';
for (let key in localVault) {
const token = localVault[key];
indexRow.innerHTML += <div class="col-md-4"> <div class="bg-black bg-opacity-40 p-3 border border-secondary rounded shadow-none text-start"> <div class="text-secondary small font-mono">${key} / USD</div> <h4 class="text-white font-mono my-1">$${token.price.toFixed(2)}</h4> <div class="text-success small font-mono" style="font-size:11px;"><i class="bi bi-graph-up me-1"></i>+4.82% Web4 Index</div> </div> </div>;
}
// Render P2P Intent Table Matrix
const tbody = document.getElementById('intentTableBody');
tbody.innerHTML = '';
activeIntents.forEach((intent, idx) => {
let badgeStyle = 'bg-warning-subtle text-warning border-warning';
if(intent.state.startsWith('Settled')) badgeStyle = 'bg-success-subtle text-success border-success';
const tr = document.createElement('tr');
tr.innerHTML = `
`;
tbody.appendChild(tr);
});
}
function executeMarketAction(direction) {
const tokenSymbol = document.getElementById('tradeToken').value;
const amount = parseFloat(document.getElementById('tradeAmount').value);
if (isNaN(amount) || amount <= 0) { alert('Enter valid quantity properties.'); return; }
if(direction === 'SELL' && localVault[tokenSymbol].balance < amount) {
alert('Insufficient structural wallet inventory.'); return;
}
const newId = 'w4-intent-' + Math.floor(Math.random() * 900 + 100);
activeIntents.unshift({ id: newId, asset: tokenSymbol, dir: direction, qty: amount, state: 'Matching' });
if (direction === 'BUY') {
localVault[tokenSymbol].balance += amount;
} else {
localVault[tokenSymbol].balance -= amount;
}
const term = document.getElementById('marketTerminal');
term.innerHTML += \n[INTENT]: Signed ${direction} path for ${amount} ${tokenSymbol} via cryptography.;
term.scrollTop = term.scrollHeight;
refreshMarketUiAll();
}
function cancelIntentIndex(index) {
activeIntents.splice(index, 1);
refreshMarketUiAll();
}
function switchMarketContext(profile) {
const term = document.getElementById('marketTerminal');
term.innerHTML += \n[SYSTEM]: Context altered to profile parameters [${profile}].;
term.scrollTop = term.scrollHeight;
}
function simulateAgentArbitrage() {
const term = document.getElementById('marketTerminal');
term.innerHTML += \n[AGENT]: Inspecting decentralized token liquidity vectors...;
term.scrollTop = term.scrollHeight;
setTimeout(() => {
term.innerHTML += \n[AGENT]: Mispricing anomaly spotted across wETH/W4 pools.;
term.innerHTML += \n[AGENT]: Resolving multi-chain router intent path payload...;
term.scrollTop = term.scrollHeight;
}, 1000);
setTimeout(() => {
term.innerHTML += \n[AGENT]: Swap settled! Multi-hop execution context verified cleanly.;
term.scrollTop = term.scrollHeight;
localVault['W4'].balance += 120.50;
refreshMarketUiAll();
}, 2500);
}



