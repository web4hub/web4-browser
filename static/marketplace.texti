// Live Real-Time Activity Webhook Notification Alert Generator
function triggerActivityToastWebhookNotification(title, msg, iconClass = "bi-cpu-fill") {
const container = document.getElementById('toastContainer');
const toastDiv = document.createElement('div');
toastDiv.className = "card border-secondary bg-dark text-white p-3 shadow-lg border-start border-3 border-info";
toastDiv.style.width = "280px";
toastDiv.style.opacity = "0";
toastDiv.style.transition = "opacity 0.3s ease-in-out";
toastDiv.innerHTML = <div class="d-flex align-items-start gap-2"> <i class="bi ${iconClass} text-info fs-5 mt-n1"></i> <div class="flex-grow-1"> <div class="fw-bold small font-mono text-uppercase tracking-wider">${title}</div> <div class="text-secondary font-monospace mt-1" style="font-size:11px; line-height:13px;">${msg}</div> </div> </div>;
container.appendChild(toastDiv);
setTimeout(() => { toastDiv.style.opacity = "1"; }, 50);
setTimeout(() => {
toastDiv.style.opacity = "0";
setTimeout(() => { toastDiv.remove(); }, 300);
}, 4500);
}
function refreshGatewayUiAll() {
const noteContainer = document.getElementById('paperCurrencyList');
noteContainer.innerHTML = '';
let baseRollingSum = 0;
digitalCashNotes.forEach((note, index) => {
baseRollingSum += (note.denomination * fxRates[note.currency]);
const div = document.createElement('div');
div.className = 'currency-card p-2 rounded d-flex justify-content-between align-items-center mb-1';
if(targetedNoteIndex === index) {
div.style.borderColor = 'var(--w4-bank)';
div.style.backgroundColor = 'rgba(0, 242, 254, 0.05)';
}
div.onclick = () => selectNoteForRemittance(index);
div.innerHTML = <div> <div class="small fw-bold font-mono text-success"><i class="bi bi-ticket-perforated-fill me-2"></i>${currencySymbols[note.currency]}${note.denomination.toLocaleString()} ${note.currency}</div> <div class="text-secondary font-monospace" style="font-size:9px;">Serial: ${note.serial}</div> </div> <i class="bi bi-shield-lock-fill text-secondary"></i>;
noteContainer.appendChild(div);
});
document.getElementById('totalVaultLabel').innerText = ₦${baseRollingSum.toLocaleString()};
const tbody = document.getElementById('clearingLogBody');
tbody.innerHTML = '';
historicalClearingLogs.forEach(log => {
const tr = document.createElement('tr');
tr.innerHTML = `
`;
tbody.appendChild(tr);
});
}
function selectNoteForRemittance(index) {
targetedNoteIndex = index;
const note = digitalCashNotes[index];
const sym = currencySymbols[note.currency];
document.getElementById('targetNoteField').value = ${note.serial} (${sym}${note.denomination.toLocaleString()});
document.getElementById('blueprintContainer').classList.remove('d-none');
document.getElementById('pdfDenomination').innerText = ${sym}${note.denomination.toLocaleString()} ${note.currency};
document.getElementById('pdfSerial').innerText = note.serial;
document.getElementById('pdfHash').innerText = Content Ledger Hash: ${note.hash};
refreshGatewayUiAll();
}
function executeFxNoteSwap() {
if(targetedNoteIndex === null) { alert('Select a cash sheet from the left inventory ledger first.'); return; }
const note = digitalCashNotes[targetedNoteIndex];
const targetCurrency = document.getElementById('fxTargetCurrency').value;
if(note.currency === targetCurrency) { alert('Asset is already denominated in selected target parameter currency.'); return; }
const term = document.getElementById('gatewayTerminal');
term.innerHTML += \n[FX_ENGINE]: Swapping note currency context ${note.currency} ⟶ ${targetCurrency}.;
let currentBaseValue = note.denomination * fxRates[note.currency];
let newDenomination = Math.round(currentBaseValue / fxRates[targetCurrency]);
note.history.unshift([2026-10-09 21:48:32] FX_CURRENCY_SWAP // Mutated Denomination from ${currencySymbols[note.currency]}${note.denomination} ${note.currency} into ${currencySymbols[targetCurrency]}${newDenomination} ${targetCurrency});
const oldSerial = note.serial;
note.currency = targetCurrency;
note.denomination = newDenomination;
note.serial = W4-${targetCurrency}- + Math.random().toString(36).substring(2, 8).toUpperCase();
term.innerHTML += \n[FX_ENGINE]: Re-issued mutated serial wrapper: ${note.serial};
term.scrollTop = term.scrollHeight;
triggerActivityToastWebhookNotification("FX Mutation Webhook", Note burned: ${oldSerial}\nRe-issued: ${note.serial} (${currencySymbols[targetCurrency]}${newDenomination}), "bi-currency-exchange");
saveStateToPipeline();
selectNoteForRemittance(targetedNoteIndex);
}
function launchAuditTrailModal() {
if(targetedNoteIndex === null) return;
const note = digitalCashNotes[targetedNoteIndex];
document.getElementById('auditModalSerial').innerText = note.serial;
document.getElementById('auditModalHash').innerText = note.hash;
const list = document.getElementById('auditTrailList');
list.innerHTML = '';
note.history.forEach(logLine => {
list.innerHTML += <div class="list-group-item bg-black border-secondary text-secondary small p-2 font-mono"><i class="bi bi-shield-check text-info me-2"></i>${logLine}</div>;
});
bsAuditModalObj.show();
}
function launchIdentityRecoveryModal() {
bsRecoveryModalObj.show();
}
function executeIdentityRecoverySync() {
const rawPhrase = document.getElementById('recoverySeedInput').value.trim();
if(!rawPhrase || rawPhrase.split(' ').length < 12) { alert('Sovereign recovery phrase check failed.'); return; }
document.getElementById('activeProfileLabel').innerText = "Recovered Signer Node";
document.getElementById('activeDidLabel').innerText = "did:w4:fiat:recovered" + Math.floor(Math.random() * 100);
digitalCashNotes = [...defaultInitialNotes];
saveStateToPipeline();
targetedNoteIndex = null;
document.getElementById('blueprintContainer').classList.add('d-none');
document.getElementById('targetNoteField').value = '';
const term = document.getElementById('gatewayTerminal');
term.innerHTML += \n[RECOVERY]: Mnemonic verified. Keys synchronized successfully.;
term.scrollTop = term.scrollHeight;
triggerActivityToastWebhookNotification("Identity Sync Event", "Sovereign cryptographic keys regenerated.\nVault balance layers hard synced.", "bi-key-fill");
bsRecoveryModalObj.hide();
refreshGatewayUiAll();
}
function mintCashVoucher() {
const refNum = document.getElementById('mintRef').value;
const amount = parseInt(document.getElementById('mintAmount').value);
if(!refNum.trim()) return;
const newSerial = 'W4-NGN-' + Math.random().toString(36).substring(2, 8).toUpperCase();
const mockCid = 'ipfs://bafybeimint' + Math.random().toString(16).substring(2, 10);
const newNote = {
serial: newSerial, denomination: amount, currency: 'NGN', hash: mockCid,
history: [[2026-10-09 21:48:32] MINT_INBOUND_DEPOSIT_RESERVE // Bank Ref Match Proof: ${refNum}]
};
digitalCashNotes.unshift(newNote);
document.getElementById('gatewayTerminal').innerHTML += \n[MINTER]: Minted new note asset nodes successfully. [Serial: ${newSerial}];
triggerActivityToastWebhookNotification("Minter Webhook", Mint success.\nAsset: ${newSerial}\nDenom: ₦${amount.toLocaleString()}, "bi-hammer");
saveStateToPipeline();
refreshGatewayUiAll();
selectNoteForRemittance(0);
}
function triggerYieldOptimization() {
if(digitalCashNotes.length === 0) { alert('No liquid cash sheets remaining in your vault.'); return; }
const note = digitalCashNotes;
const sym = currencySymbols[note.currency];
const term = document.getElementById('gatewayTerminal');
term.innerHTML += \n[YIELD_AGENT]: Inspecting yield opportunities for ${sym}${note.denomination.toLocaleString()} ${note.currency}...;
term.scrollTop = term.scrollHeight;
setTimeout(() => {
term.innerHTML += \n[YIELD_AGENT]: Deploying asset into Credit Syndicate Alpha pool (+14.2% APY).;
note.history.unshift([2026-10-09 21:49:12] STAKE_YIELD_OPTIMIZER // Deployed asset wrapper node into Credit Syndicate Alpha micro-pool);
const oldSerial = note.serial;
note.serial = STAKE-${note.currency}- + Math.random().toString(36).substring(2, 7).toUpperCase();
triggerActivityToastWebhookNotification("Yield Oracle Webhook", Asset locked to syndicate:\n${oldSerial} ⟶ ${note.serial}, "bi-rocket-takeoff");
term.scrollTop = term.scrollHeight;
saveStateToPipeline();
if(targetedNoteIndex === 0) selectNoteForRemittance(0);
refreshGatewayUiAll();
}, 1500);
}
function exportNoteAsPDF() {
const element = document.getElementById('targetPDFNote');
const serial = document.getElementById('pdfSerial').innerText;
const options = {
margin: 10, filename: Web4-Note-${serial}.pdf, image: { type: 'jpeg', quality: 0.98 },
html2canvas: { scale: 2, backgroundColor: '#070d0a' }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' }
};
html2pdf().set(options).from(element).save();
}
function processBankRemittance() {
if(targetedNoteIndex === null) return;
const bank = document.getElementById('bankRoute').value;
const account = document.getElementById('bankAccount').value;
if(!account.trim() || account.length < 10) return;
const note = digitalCashNotes[targetedNoteIndex];
const sym = currencySymbols[note.currency];
const newTxId = 'tx-clear-' + Math.floor(Math.random() * 900 + 100);
historicalClearingLogs.unshift({
id: newTxId, serial: note.serial, institution: bank, account: account,
amount: ${sym}${note.denomination.toLocaleString()} ${note.currency}, proof: 'Clearing_Initiated'
});
const burningSerial = note.serial;
const totalClearedString = ${sym}${note.denomination.toLocaleString()};
digitalCashNotes.splice(targetedNoteIndex, 1);
targetedNoteIndex = null;
document.getElementById('targetNoteField').value = '';
document.getElementById('blueprintContainer').classList.add('d-none');
document.getElementById('gatewayTerminal').innerHTML += \n[GATEWAY]: Transmitted burn sequence. Initiating credit payload to ${bank}...;
saveStateToPipeline();
triggerActivityToastWebhookNotification("Remittance Webhook", Clearing pending: ${burningSerial}\nTargeting: ${bank}, "bi-bank2");
setTimeout(() => {
historicalClearingLogs.proof = 'Settled_Cleared';
document.getElementById('gatewayTerminal').innerHTML += \n[GATEWAY]: Settlement completed flawlessly to local retail account.;
triggerActivityToastWebhookNotification("Clearing Completed", Credit processed: ${totalClearedString}\nAccount: ${account}, "bi-check-circle-fill");
saveStateToPipeline();
refreshGatewayUiAll();
}, 3000);
refreshGatewayUiAll();
}
function triggerAutoClearingAgent() {
if(digitalCashNotes.length === 0) return;
selectNoteForRemittance(0);
setTimeout(() => { processBankRemittance(); }, 1500);
}



