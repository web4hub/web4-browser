<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head> 
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web4 Sovereign Token Exchange & Intent Matrix</title>
    <!-- Bootstrap 5 CSS & Icons CDN -->
    <link href="https://jsdelivr.net" rel="stylesheet">
    <link href="https://jsdelivr.net" rel="stylesheet">
    <style>
        :root {
            --w4-glow: #00f2fe;
            --w4-success: #00ff87;
            --w4-agent: #aa33ff;
            --surface-bg: #08090c;
            --panel-bg: #111318;
            --card-bg: #171a21;
            --border-ui: #242936;
        }

        body {
            background-color: var(--surface-bg);
            color: #f8f9fa;
            height: 100vh;
            overflow: hidden;
            font-family: 'Inter', system-ui, sans-serif;
        }

        .web4-header {
            background-color: var(--panel-bg);
            border-bottom: 1px solid var(--border-ui);
        }

        .brand-gradient {
            font-weight: 800;
            background: linear-gradient(90deg, #00f2fe, #aa33ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .workspace-grid {
            height: calc(100vh - 70px);
        }

        .w4-sidebar {
            background-color: var(--panel-bg);
            border-right: 1px solid var(--border-ui);
            width: 340px;
        }

        .asset-card {
            background: var(--card-bg);
            border: 1px solid var(--border-ui);
            transition: all 0.2s ease-in-out;
        }

        .asset-card:hover {
            border-color: var(--w4-glow);
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.12);
        }

        .agent-terminal {
            background-color: #050608;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.8rem;
            color: #adbac7;
            border: 1px solid var(--border-ui);
            height: 200px;
            overflow-y: auto;
        }

        .market-canvas {
            background-color: #0a0b10;
            position: relative;
            overflow-y: auto;
        }

        .font-mono {
            font-family: 'Courier New', Courier, monospace;
        }
    </style>
</head>
<body>

    
    <header class="navbar navbar-dark web4-header px-4 py-2">
        <div class="container-fluid p-0">
            <span class="navbar-brand brand-gradient fs-5 m-0 me-auto">
                <i class="bi bi-cpu-fill me-2"></i>WEB4 // TRUSTLESS INTENT & TOKEN MARKETPLACE
            </span>
            
            
            <div class="d-flex align-items-center bg-black bg-opacity-40 border border-secondary border-opacity-20 rounded-pill p-1 pe-3">
                <div class="rounded-circle me-2" style="width:30px; height:30px; background: linear-gradient(135deg, #00f2fe 0%, #aa33ff 100%);"></div>
                <div class="lh-sm">
                    <div class="fw-bold text-white small">Sovereign Account</div>
                    <div class="text-secondary font-monospace" style="font-size: 10px;">did:w4:trader:88ba2...</div>
                </div>
            </div>
        </div>
    </header>

    <!-- App Main Workspace -->
    <div class="d-flex workspace-grid">
        
        <!-- Web4 Orchestration Sidebar Controls -->
        <aside class="w4-sidebar p-3 d-flex flex-column gap-3">
            
            
            <div>
                <label class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Active Wallet Profile Context</label>
                <select class="form-select form-select-sm bg-black border-secondary text-white" id="traderProfile" onchange="switchMarketContext(this.value)">
                    <option value="personal">Personal Core Balance (did:w4:trader:88ba)</option>
                    <option value="zk-shadow">ZK Private Shadow Pool (did:w4:blind:301x)</option>
                </select>
            </div>

            <!-- Model Context Protocol (MCP) Intent Matching Engine -->
            <div class="border border-secondary border-opacity-30 rounded p-3 bg-black bg-opacity-20">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="small fw-bold text-uppercase tracking-wider" style="color:var(--w4-agent);"><i class="bi bi-robot me-1"></i>MCP Agent Matcher</label>
                    <span class="badge bg-purple bg-opacity-10 text-purple border border-purple font-monospace" style="font-size:9px; color:var(--w4-agent);">Intent Engine v4</span>
                </div>
                <p class="text-secondary mb-2" style="font-size:11px;">Broadcast cryptographic trading requests. AI Agents crawl the cross-chain mesh to settle terms without order books.</p>
                <div class="agent-terminal p-2 rounded mb-2 font-mono" id="marketTerminal">
                    [SYSTEM]: Awaiting Trade Intent Submission...
                </div>
                <button class="btn btn-sm btn-outline-info w-100 text-start" onclick="simulateAgentArbitrage()" style="font-size: 11px;">
                    <i class="bi bi-lightning-charge-fill me-1 text-warning"></i>Delegate Autonomous Arbitrage Discovery
                </button>
            </div>

            <!-- Profile Portfolio Valuations Ledger -->
            <div class="flex-grow-1 overflow-y-auto">
                <label class="form-label small fw-bold text-secondary text-uppercase tracking-wider">Sovereign Vault Assets</label>
                <div class="d-flex flex-column gap-2" id="vaultBalances">
                    <!-- Balances populate here dynamically -->
                </div>
            </div>
        </aside>

        <!-- Main Marketplace Canvas Grid Area -->
        <main class="market-canvas flex-grow-1 p-4">
            
            <!-- Token Transaction Order Entry Form -->
            <div class="row g-4 mb-4">
                <div class="col-xl-4 col-md-6">
                    <div class="card bg-dark bg-opacity-50 border-secondary p-3 shadow-sm h-100">
                        <h6 class="text-white mb-3"><i class="bi bi-arrow-left-right text-info me-2"></i>Submit Trade Intent</h6>
                        
                        <div class="mb-2">
                            <label class="form-label small text-secondary">Asset Selection</label>
                            <select class="form-select bg-black border-secondary text-light shadow-none" id="tradeToken">
                                <option value="W4">W4 Native Utility Token</option>
                                <option value="WETH">Wrapped Web4 Ether (wETH)</option>
                                <option value="ZKP">Zero-Knowledge Proof Token (ZKP)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small text-secondary">Execution Target Amount</label>
                            <div class="input-group">
                                <input type="number" class="form-control bg-black border-secondary text-light font-mono shadow-none" id="tradeAmount" placeholder="0.00" value="10">
                                <span class="input-group-text bg-secondary border-secondary text-light font-mono">QTY</span>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <button class="btn btn-success w-100 fw-bold py-2" onclick="executeMarketAction('BUY')"><i class="bi bi-graph-up-arrow me-1"></i>Sign Buy</button>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-danger w-100 fw-bold py-2" onclick="executeMarketAction('SELL')"><i class="bi bi-graph-down-arrow me-1"></i>Sign Sell</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Live Market Pricing Ticker Feed -->
                <div class="col-xl-8 col-md-6">
                    <div class="card bg-dark bg-opacity-50 border-secondary p-3 shadow-sm h-100">
