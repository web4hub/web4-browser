#!/usr/bin/env bash
# ==============================================================================
# WEB4 PLATFORM WORKSPACE INITIALIZER
# File: resources/script.bs
# Version: 2.0.0
#
# Responsibilities:
#   - Validate workspace resources
#   - Provision local identity configuration
#   - Initialize execution telemetry
#   - Validate configuration JSON
#   - Optionally open local browser interfaces
#
# Security note:
#   This initializer does not create cryptographic identities, encrypt data,
#   execute MCP tools, connect to banks, or submit blockchain transactions.
# ==============================================================================

set -Eeuo pipefail
IFS=$'\n\t'
umask 077

VERSION="2.0.0"
ROOT_DIR="$(pwd)"
RUNTIME_DIR="${ROOT_DIR}/.w4_runtime_state"
RESOURCE_DIR="${ROOT_DIR}/resources"
CONFIG_FILE="${RUNTIME_DIR}/identity_config.json"
LOG_FILE="${RESOURCE_DIR}/agent_execution.log"

NO_BROWSER=false
STRICT=false

# ANSI terminal colors
GREEN='\033[38;2;0;255;135m'
BLUE='\033[38;2;0;242;254m'
PURPLE='\033[38;2;170;51;255m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
RESET='\033[0m'

usage() {
    cat <<'EOF'
Web4 Workspace Initializer

Usage:
  bash resources/script.bs [options]

Options:
  --no-browser    Do not open HTML interfaces
  --strict        Fail if required HTML interfaces are missing
  --help          Display this help
EOF
}

for arg in "$@"; do
    case "$arg" in
        --no-browser) NO_BROWSER=true ;;
        --strict) STRICT=true ;;
        --help|-h) usage; exit 0 ;;
        *)
            printf 'Unknown option: %s\n' "$arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

mkdir -p "$RESOURCE_DIR" "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR"

# Create the log with restrictive permissions.
touch "$LOG_FILE"
chmod 600 "$LOG_FILE"

log_event() {
    local type="$1"
    local message="$2"
    local timestamp

    timestamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf '[%s] [%s] %s\n' \
        "$timestamp" "$type" "$message" >> "$LOG_FILE"
}

info() {
    printf '%b[*]%b %s\n' "$BLUE" "$RESET" "$*"
}

success() {
    printf '%b[OK]%b %s\n' "$GREEN" "$RESET" "$*"
}

warn() {
    printf '%b[WARN]%b %s\n' "$YELLOW" "$RESET" "$*" >&2
}

fail() {
    printf '%b[ERROR]%b %s\n' "$RED" "$RESET" "$*" >&2
    log_event "ERROR" "$*"
    exit 1
}

# Track unexpected failures accurately.
on_error() {
    local status=$?
    log_event "EXECUTION_FAILURE" \
        "Command failed with exit status ${status}."
    printf '%b[ERROR]%b Initializer failed (exit %s).\n' \
        "$RED" "$status" >&2
    exit "$status"
}
trap on_error ERR

clear_screen() {
    if [[ -t 1 ]] && command -v clear >/dev/null 2>&1; then
        clear || true
    fi
}

clear_screen

printf '%b' "$BLUE"
printf '⎔ ========================================================= ⎔\n'
printf '       WEB4 WORKSPACE INITIALIZER v%s\n' "$VERSION"
printf '⎔ ========================================================= ⎔\n'
printf '%b\n' "$RESET"

log_event "SYSTEM_INIT" \
    "Initializer started; version=${VERSION}."

# ------------------------------------------------------------------------------
# PHASE 1: Workspace validation
# ------------------------------------------------------------------------------

info "Phase 1: Checking workspace resources"

CORE_FILES=(
    "marketplace.html"
    "fiat-gateway.html"
)

MISSING_FILES=0

for file in "${CORE_FILES[@]}"; do
    if [[ -f "${ROOT_DIR}/${file}" && -r "${ROOT_DIR}/${file}" ]]; then
        success "Resource available: ${file}"
        log_event "RESOURCE_OK" "$file"
    else
        warn "Missing or unreadable resource: ${file}"
        log_event "RESOURCE_MISSING" "$file"
        ((MISSING_FILES += 1))
    fi
done

if (( MISSING_FILES > 0 )); then
    if [[ "$STRICT" == true ]]; then
        fail "${MISSING_FILES} required workspace resource(s) unavailable."
    fi

    warn "Workspace is incomplete; continuing in degraded mode."
    log_event "DEGRADED_MODE" \
        "${MISSING_FILES} required resource(s) unavailable."
fi

# ------------------------------------------------------------------------------
# PHASE 2: Identity configuration provisioning
# ------------------------------------------------------------------------------

info "Phase 2: Provisioning local identity configuration"

if ! command -v python3 >/dev/null 2>&1; then
    fail "Python 3 is required to generate and validate JSON."
fi

# Preserve existing configuration rather than overwriting user data.
if [[ -e "$CONFIG_FILE" ]]; then
    if ! python3 - "$CONFIG_FILE" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        data = json.load(stream)
    if not isinstance(data, dict):
        raise ValueError("Configuration root must be an object")
except Exception as exc:
    print(f"Invalid existing configuration: {exc}", file=sys.stderr)
    sys.exit(1)
PY
    then
        fail "Existing configuration is invalid; refusing to overwrite it."
    fi

    success "Existing configuration preserved."
    log_event "CONFIG_PRESERVED" "Existing JSON configuration validated."
else
    TMP_CONFIG="$(mktemp "${RUNTIME_DIR}/.identity_config.XXXXXX")"

    cleanup_temp() {
        if [[ -n "${TMP_CONFIG:-}" && -f "${TMP_CONFIG:-}" ]]; then
            rm -f -- "$TMP_CONFIG"
        fi
    }
    trap cleanup_temp EXIT

    # These are development identifiers, not authenticated identities.
    cat > "$TMP_CONFIG" <<'JSON'
{
  "schema_version": "1.0",
  "environment": "development",
  "active_signer": null,
  "actor_profiles": {
    "personal-core": {
      "name": "Personal Core",
      "did": null,
      "vault_ledger": null
    },
    "zk-shadow": {
      "name": "Ephemeral Privacy Profile",
      "did": null,
      "vault_ledger": null
    }
  },
  "services": {
    "nibss_gateway": null,
    "ipfs_gateway": "https://ipfs.io"
  },
  "runtime_parameters": {
    "persistence": true,
    "mcp_agent_routing": false,
    "iso20022_compliance": false
  }
}
JSON

    python3 -m json.tool "$TMP_CONFIG" >/dev/null ||
        fail "Generated configuration failed JSON validation."

    chmod 600 "$TMP_CONFIG"
    mv -- "$TMP_CONFIG" "$CONFIG_FILE"
    TMP_CONFIG=""

    success "Development configuration created and validated."
    log_event "CONFIG_CREATED" \
        "Development configuration initialized; no credentials provisioned."
fi

# ------------------------------------------------------------------------------
# PHASE 3: Agent orchestration readiness
# ------------------------------------------------------------------------------

info "Phase 3: Checking agent orchestration prerequisites"

if [[ -n "${WEB4_MCP_ENDPOINT:-}" ]]; then
    info "MCP endpoint environment variable is configured."
    warn "Endpoint reachability and MCP protocol compatibility are not verified."
    log_event "MCP_CONFIGURED" \
        "Endpoint variable detected; connectivity not verified."
else
    warn "No MCP endpoint configured; agent routing remains disabled."
    log_event "MCP_DISABLED" \
        "No MCP endpoint configured."
fi

printf '%b[MCP STATUS]%b Local orchestration simulation only.\n' \
    "$PURPLE" "$RESET"

printf '%b[ROUTING STATUS]%b No live arbitrage execution.\n' \
    "$PURPLE" "$RESET"

log_event "AGENT_SIMULATION" \
    "Displayed simulated orchestration status; no external agent invoked."

# ------------------------------------------------------------------------------
# PHASE 4: Browser viewport activation
# ------------------------------------------------------------------------------

open_local_page() {
    local page="$1"
    local target="${ROOT_DIR}/${page}"

    [[ -f "$target" ]] || {
        warn "Skipping unavailable page: $page"
        log_event "VIEWPORT_SKIPPED" "$page"
        return 0
    }

    if [[ "$NO_BROWSER" == true ]]; then
        info "Browser launch disabled: $page"
        log_event "VIEWPORT_DISABLED" "$page"
        return 0
    fi

    case "$(uname -s)" in
        Linux*)
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$target" >/dev/null 2>&1 &
                log_event "VIEWPORT_REQUESTED" "$page via xdg-open"
                success "Browser launch requested: $page"
            else
                warn "xdg-open unavailable; open $target manually."
                log_event "VIEWPORT_UNAVAILABLE" "$page"
            fi
            ;;
        Darwin*)
            if command -v open >/dev/null 2>&1; then
                open "$target" >/dev/null 2>&1 &
                log_event "VIEWPORT_REQUESTED" "$page via open"
                success "Browser launch requested: $page"
            else
                warn "macOS open command unavailable."
                log_event "VIEWPORT_UNAVAILABLE" "$page"
            fi
            ;;
        CYGWIN*|MINGW*|MSYS*)
            if command -v cmd.exe >/dev/null 2>&1; then
                local windows_path
                windows_path="$(cygpath -w "$target")"
                cmd.exe /c start "" "$windows_path" \
                    >/dev/null 2>&1 &
                log_event "VIEWPORT_REQUESTED" "$page via Windows shell"
                success "Browser launch requested: $page"
            else
                warn "Windows shell unavailable."
                log_event "VIEWPORT_UNAVAILABLE" "$page"
            fi
            ;;
        *)
            warn "Unsupported OS; open $target manually."
            log_event "VIEWPORT_UNAVAILABLE" \
                "Unsupported OS for $page"
            ;;
    esac
}

info "Phase 4: Processing browser interfaces"

open_local_page "fiat-gateway.html"
open_local_page "marketplace.html"

# ------------------------------------------------------------------------------
# PHASE 5: Execution summary
# ------------------------------------------------------------------------------

printf '\n%b' "$GREEN"
printf '⎔ ========================================================= ⎔\n'
printf '             WORKSPACE INITIALIZATION COMPLETE\n'
printf '⎔ ========================================================= ⎔\n'
printf '%b\n' "$RESET"

printf 'Configuration: %s\n' "$CONFIG_FILE"
printf 'Telemetry:     %s\n' "$LOG_FILE"
printf 'Missing files: %s\n' "$MISSING_FILES"

if (( MISSING_FILES > 0 )); then
    warn "Initialization completed with warnings."
    log_event "SYSTEM_COMPLETE_WITH_WARNINGS" \
        "Initialization finished with ${MISSING_FILES} missing resource(s)."
else
    success "Local workspace checks completed."
    log_event "SYSTEM_COMPLETE" \
        "Local initialization finished; external integrations unverified."
fi

printf '\nNote: This confirms local setup only, not production readiness.\n'
